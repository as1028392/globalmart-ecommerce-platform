# ==============================================================================
# DATABASE & CACHE
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/globalmart
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=GlobalMart
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-strong-key
WEBSITE_URL=https://globalmart.com

# ==============================================================================
# JWT & AUTHENTICATION
# ==============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-generate-strong-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# PAYMENT GATEWAYS
# ==============================================================================
# Paymob Integration (Egypt - Visa/Mastercard/Meeza)
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-paymob-integration-id
PAYMOB_IFRAME_ID=your-paymob-iframe-id

# Fawry Integration (Egypt - Vodafone Cash, Meeza)
FAWRY_MERCHANT_CODE=your-fawry-merchant-code
FAWRY_SECURITY_KEY=your-fawry-security-key

# ==============================================================================
# SHIPPING & LOGISTICS
# ==============================================================================
# Aramex (International Shipping)
ARAMEX_API_KEY=your-aramex-api-key
ARAMEX_ACCOUNT_NUMBER=your-aramex-account-number
ARAMEX_ENTITY_ID=your-aramex-entity-id

# Bosta (Domestic Delivery - Egypt)
BOSTA_API_KEY=your-bosta-api-key

# ==============================================================================
# EXTERNAL PRODUCT FEEDS
# ==============================================================================
# AliExpress API
ALIEXPRESS_APP_KEY=your-aliexpress-app-key
ALIEXPRESS_APP_SECRET=your-aliexpress-app-secret
ALIEXPRESS_AFFILIATE_ID=your-aliexpress-affiliate-id

# Turkish Textile Factories API (if applicable)
TURKISH_SUPPLIER_API_KEY=your-turkish-supplier-api-key

# Korean Beauty Platforms API (if applicable)
KOREAN_BEAUTY_API_KEY=your-korean-beauty-api-key

# ==============================================================================
# CURRENCY & EXCHANGE RATE
# ==============================================================================
# Exchange rate API for USD to EGP conversion
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# ==============================================================================
# NOTIFICATIONS
# ==============================================================================
# Twilio (SMS Notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Push Notifications)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json

# ==============================================================================
# EMAIL SERVICE
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@globalmart.com
SMTP_FROM_NAME=GlobalMart Support

# ==============================================================================
# ENCRYPTION
# ==============================================================================
# Fernet encryption key for PII (personally identifiable information)
ENCRYPTION_KEY=your-fernet-encryption-key

# ==============================================================================
# CORS & SECURITY
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost,https://globalmart.com
ALLOWED_HOSTS=localhost,127.0.0.1,globalmart.com

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ==============================================================================
# FRONTEND (Optional - if backend serves config)
# ==============================================================================
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost/api/v1
